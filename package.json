{
  "name": "widget-generator-edgetx",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @widget-gen/shared && npm run build -w @widget-gen/generator && npm run build -w @widget-gen/web",
    "dev": "npm run dev --workspace=@widget-gen/web",
    "generate": "npm run generate --workspace=@widget-gen/generator",
    "sync-stubs": "node scripts/sync-edgetx-stubs.mjs",
    "test": "npm run test --workspace=@widget-gen/generator",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
