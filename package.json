{
  "name": "widget-generator-edgetx",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/ensure-edgetx-wasm.mjs && npm run build -w @widget-gen/web",
    "dev": "node scripts/ensure-edgetx-wasm.mjs && npm run dev --workspace=@widget-gen/web",
    "generate": "npm run generate --workspace=@widget-gen/generator",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "sync-stubs": "node scripts/sync-edgetx-stubs.mjs",
    "sync-wasm": "node scripts/sync-edgetx-wasm.mjs",
    "setup": "node scripts/setup.mjs",
    "setup:sim": "node scripts/setup.mjs --sim",
    "postinstall": "node scripts/patch-simulator-ui.mjs && node scripts/ensure-edgetx-wasm.mjs",
    "reset-chats": "node scripts/reset-chats.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:wasm": "npm run test:wasm --workspace=@widget-gen/sim-preview",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "oxlint": "^1.75.0"
  }
}
