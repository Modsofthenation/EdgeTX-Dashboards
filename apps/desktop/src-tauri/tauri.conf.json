{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EdgeTX Dashboards",
  "version": "0.1.0",
  "identifier": "com.edgetx.dashboards",
  "build": {
    "beforeDevCommand": "cd ../.. && SKIP_WASM_SYNC=1 npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "node ./scripts/prepare-fallback.mjs",
    "frontendDist": "../fallback"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EdgeTX Dashboards",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Generate and edit EdgeTX Lua dashboards",
    "longDescription": "Desktop shell for the EdgeTX Dashboard Generator \u2014 wraps the Next.js web app in a native window via Tauri 2."
  }
}
