{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default desktop capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-focus",
    "core:webview:allow-webview-position",
    "core:webview:allow-webview-size",
    "shell:allow-open",
    "dialog:default",
    "dialog:allow-open"
  ]
}
