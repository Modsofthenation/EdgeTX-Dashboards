{
  "protocol": "rotorflight",
  "label": "Rotorflight (CRSF/ELRS)",
  "setupNotes": [
    "Enable rf2bg as a Special Function with Repeat set to On for custom CRSF/ELRS telemetry.",
    "Delete all sensors, select Discover new, then power on the flight controller.",
    "Rotorflight Tools scripts (rf2.lua) are separate from dashboard widgets.",
    "For adjustment teller: set crsf_flight_mode_reuse = ADJFUNC in Rotorflight CLI and save."
  ],
  "sensors": [
    { "name": "1RSS", "unit": "dB", "category": "link", "description": "Uplink RSSI antenna 1" },
    { "name": "RQLY", "unit": "%", "category": "link", "description": "Uplink link quality" },
    { "name": "RFMD", "unit": "", "category": "link", "description": "Uplink packet rate" },
    { "name": "TPWR", "unit": "mW", "category": "link", "description": "Uplink transmit power" },
    { "name": "RxBt", "unit": "V", "category": "battery", "description": "Battery voltage" },
    { "name": "Curr", "unit": "A", "category": "battery", "description": "Current draw" },
    { "name": "Capa", "unit": "mAh", "category": "battery", "description": "Consumed capacity" },
    { "name": "Bat%", "unit": "%", "category": "battery", "description": "Battery remaining" },
    { "name": "Alt", "unit": "m", "category": "gps", "description": "Baro/GPS altitude" },
    { "name": "GSpd", "unit": "km/h", "category": "gps", "description": "GPS ground speed" },
    { "name": "Sats", "unit": "", "category": "gps", "description": "GPS satellite count" },
    { "name": "FM", "unit": "", "category": "flight", "description": "Flight mode" },
    { "name": "RPM", "unit": "rpm", "category": "motor", "description": "Motor/head RPM", "requiresCustomCrsf": true },
    { "name": "HSpd", "unit": "rpm", "category": "motor", "description": "Headspeed", "requiresCustomCrsf": true },
    { "name": "EscT", "unit": "C", "category": "motor", "description": "ESC temperature", "requiresCustomCrsf": true },
    { "name": "MotT", "unit": "C", "category": "motor", "description": "Motor temperature", "requiresCustomCrsf": true },
    { "name": "AdjF", "unit": "", "category": "flight", "description": "Adjustment function", "requiresCustomCrsf": true },
    { "name": "AdjV", "unit": "", "category": "flight", "description": "Adjustment value", "requiresCustomCrsf": true }
  ]
}
