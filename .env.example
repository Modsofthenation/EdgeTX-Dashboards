# AI provider API keys (required for generation unless supplied from the UI)
# Users can also set a browser key in Preferences → AI.
# Headers: x-cursor-api-key / x-anthropic-api-key / x-openai-api-key / x-gemini-api-key + x-ai-provider
CURSOR_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: override SQLite chat DB and runtime data directory (default: <repo>/data)
WIDGET_GEN_DATA_DIR=

# Optional: protect API routes when the app is not localhost-only
# GENERATOR_API_SECRET=

# Cursor local agent sandbox (default ON). Set to 0/false only for local debugging
# that needs broader filesystem access outside generated/.
# CURSOR_SANDBOX_ENABLED=0
