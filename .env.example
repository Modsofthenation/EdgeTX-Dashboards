# AI provider API keys (required for generation unless supplied from the UI)
# Users can also set a browser key in Preferences → AI.
# Headers: x-cursor-api-key / x-anthropic-api-key / x-openai-api-key / x-gemini-api-key + x-ai-provider
CURSOR_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: override SQLite chat DB and runtime data directory (default: <repo>/data)
WIDGET_GEN_DATA_DIR=

# Protect API routes on non-loopback hosts. Localhost / desktop leave this unset.
# When set, external clients send Authorization: Bearer <secret> or x-generator-secret.
# Same-origin browser requests from the web UI are allowed without the header.
# GENERATOR_API_SECRET=

# Escape hatch: allow unauthenticated API access from non-loopback (LAN demos only).
# Never combine with server-side AI keys on the public internet.
# GENERATOR_ALLOW_UNAUTHENTICATED=1

# Optional: override EdgeTX WASM firmware download base (default: project blob mirror).
# EDGETX_WASM_BASE=https://example.com/wasm

# Cursor local agent sandbox (default ON for web/dev).
# Packaged desktop sets CURSOR_SANDBOX_ENABLED=0 explicitly in the Tauri sidecar
# (Windows sandbox needs WSL2). Set to 0/false for local debugging that needs
# broader FS access.
# CURSOR_SANDBOX_ENABLED=0
